{
  "entities": {
    "BloomCampusUser": {
      "title": "BloomCampusUser",
      "description": "Private user account, cycle logs, mood tracking, client appointments, and Sidratu skincare data keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID owning this private user document.",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Normalized lowercase user email address.",
          "maxLength": 254
        },
        "name": {
          "type": "string",
          "description": "Full name of the user.",
          "minLength": 1,
          "maxLength": 200
        },
        "age": {
          "type": "string",
          "description": "Optional age entered by the user.",
          "maxLength": 20
        },
        "phone": {
          "type": "string",
          "description": "Optional phone number entered by the user.",
          "maxLength": 60
        },
        "role": {
          "type": "string",
          "enum": ["admin", "client"],
          "description": "Role-based permission level."
        },
        "createdAt": {
          "type": "number",
          "description": "Account creation timestamp in milliseconds."
        },
        "lastUpdatedAt": {
          "type": "string",
          "description": "ISO timestamp of last profile or log update.",
          "maxLength": 64
        },
        "lastSignInAt": {
          "type": "string",
          "description": "ISO timestamp of most recent sign-in.",
          "maxLength": 64
        },
        "signInCount": {
          "type": "number",
          "description": "Total number of user sign-ins."
        },
        "subscriptionStatus": {
          "type": "string",
          "enum": ["active", "free_password", "pending_verification", "expired", "trial"],
          "description": "Current subscription or 1-week free trial status."
        },
        "subscriptionUntil": {
          "type": "number",
          "description": "Trial or pass expiration timestamp in milliseconds."
        },
        "paymentMethod": {
          "type": "string",
          "description": "Active access method label.",
          "maxLength": 200
        },
        "isVip": {
          "type": "boolean",
          "description": "Whether the user has an approved or unlocked pass."
        },
        "customCycleLength": {
          "type": "number",
          "description": "User-entered menstrual cycle length in days."
        },
        "periods": {
          "type": "array",
          "description": "User-logged menstrual period start and end dates."
        },
        "dailyLogs": {
          "type": "object",
          "description": "User-logged mood, physical symptoms with intensity, hydration, and notes keyed by YYYY-MM-DD."
        },
        "emergencyPills": {
          "type": "array",
          "description": "User-logged emergency contraception timestamps."
        },
        "journalEntries": {
          "type": "array",
          "description": "User-written cycle journal reflections."
        },
        "skincareGoal": {
          "type": "string",
          "description": "Selected Sidratu skincare goal.",
          "maxLength": 120
        },
        "appointments": {
          "type": "array",
          "description": "User-booked Sidratu clinic appointments."
        },
        "therapyLogs": {
          "type": "array",
          "description": "User-logged Sidratu skincare therapy sessions."
        },
        "academicTasks": {
          "type": "array",
          "description": "User-entered study and exam planner tasks."
        },
        "customerNumber": {
          "type": "number",
          "description": "Sequential customer entry number."
        },
        "firstEntryAt": {
          "type": "number",
          "description": "First entry timestamp in milliseconds."
        },
        "submittedFreeCode": {
          "type": "string",
          "description": "Free pass code submitted for rule-level verification.",
          "maxLength": 100
        }
      },
      "required": ["uid", "email", "name", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator lookup document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "addedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["uid", "email", "addedAt"]
    },
    "SidratuClientAppointment": {
      "title": "SidratuClientAppointment",
      "description": "Client appointment at Sidratu Beauty Therapy Skin Care isolated by owner userId.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "userName": {
          "type": "string",
          "maxLength": 200
        },
        "treatmentType": {
          "type": "string",
          "maxLength": 200
        },
        "requestedDate": {
          "type": "string",
          "maxLength": 32
        },
        "requestedTime": {
          "type": "string",
          "maxLength": 32
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Confirmed"]
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "userEmail", "treatmentType", "requestedDate", "requestedTime", "status", "createdAt"]
    },
    "SidratuSkincareLog": {
      "title": "SidratuSkincareLog",
      "description": "Client skincare therapy log isolated by owner userId.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "treatmentType": {
          "type": "string",
          "maxLength": 200
        },
        "sessionDate": {
          "type": "string",
          "maxLength": 32
        },
        "postSessionFeeling": {
          "type": "string",
          "maxLength": 2000
        },
        "stageAtSession": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "userEmail", "treatmentType", "sessionDate", "postSessionFeeling"]
    },
    "AdminSettings": {
      "title": "AdminSettings",
      "description": "Owner admin configuration settings accessible only to admins.",
      "type": "object",
      "properties": {
        "ownerEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "adminPassword": {
          "type": "string",
          "maxLength": 200
        },
        "freeAccessPassword": {
          "type": "string",
          "maxLength": 200
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["ownerEmail", "updatedAt"]
    },
    "SupportInquiry": {
      "title": "SupportInquiry",
      "description": "Payment verification or support inquiry owned by the submitting user and readable by admins.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "maxLength": 200
        },
        "userEmail": {
          "type": "string",
          "maxLength": 254
        },
        "subject": {
          "type": "string",
          "maxLength": 300
        },
        "message": {
          "type": "string",
          "maxLength": 5000
        },
        "type": {
          "type": "string",
          "enum": ["payment", "support", "login", "signup", "welcome", "appreciation"]
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "userName", "userEmail", "subject", "message", "type", "createdAt"]
    },
    "CommunityComment": {
      "title": "CommunityComment",
      "description": "Community board feedback containing no PII, authored by signed-in users.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "maxLength": 200
        },
        "commentText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "stageTag": {
          "type": "string",
          "maxLength": 64
        },
        "treatmentTag": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "userName", "commentText", "createdAt"]
    },
    "CustomerEntryLog": {
      "title": "CustomerEntryLog",
      "description": "Sign-in audit entry owned by userId and visible only to that user or admins.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "enum": ["admin", "client"]
        },
        "entryType": {
          "type": "string",
          "maxLength": 60
        },
        "deviceInfo": {
          "type": "string",
          "maxLength": 200
        },
        "firstEntryAt": {
          "type": "number"
        },
        "timestamp": {
          "type": "number"
        },
        "timestampIso": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "email", "name", "timestamp"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Authoritative list of admin UIDs."
    },
    "/bloomcampus_users/{userId}": {
      "schema": { "$ref": "#/entities/BloomCampusUser" },
      "description": "Private user account, cycle logs, mood logs, and clinic history keyed by Firebase Auth UID."
    },
    "/bloomcampus_entries/{entryId}": {
      "schema": { "$ref": "#/entities/CustomerEntryLog" },
      "description": "Sign-in activity entries isolated by userId and readable by admins."
    },
    "/bloomcampus_appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/SidratuClientAppointment" },
      "description": "Sidratu clinic client appointments isolated by userId and readable by admins."
    },
    "/bloomcampus_skincare_logs/{logId}": {
      "schema": { "$ref": "#/entities/SidratuSkincareLog" },
      "description": "Sidratu client skincare therapy logs isolated by userId and readable by admins."
    },
    "/bloomcampus_config/{configId}": {
      "schema": { "$ref": "#/entities/AdminSettings" },
      "description": "Admin-only configuration settings."
    },
    "/bloomcampus_inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/SupportInquiry" },
      "description": "Support and payment verification inquiries isolated by userId and readable by admins."
    },
    "/bloomcampus_comments/{commentId}": {
      "schema": { "$ref": "#/entities/CommunityComment" },
      "description": "Community board comments authored by verified users."
    }
  }
}
