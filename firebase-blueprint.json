{
  "entities": {
    "BloomCampusUser": {
      "title": "BloomCampusUser",
      "description": "Registered user account and cycle tracking profile in BloomCampus & Sidratu Clinic.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Normalized lowercase user email address.",
          "maxLength": 254
        },
        "name": {
          "type": "string",
          "description": "Full name of the user.",
          "maxLength": 200
        },
        "age": {
          "type": "string",
          "description": "Age of the user.",
          "maxLength": 20
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the user.",
          "maxLength": 60
        },
        "password": {
          "type": "string",
          "description": "User account password for cross-device sign-in.",
          "maxLength": 200
        },
        "createdAt": {
          "type": "number",
          "description": "Account registration timestamp in milliseconds."
        },
        "lastUpdatedAt": {
          "type": "string",
          "description": "ISO timestamp of last profile or log update.",
          "maxLength": 64
        },
        "lastSignInAt": {
          "type": "string",
          "description": "ISO timestamp of most recent sign-in or active session.",
          "maxLength": 64
        },
        "signInCount": {
          "type": "number",
          "description": "Total number of times the user has signed in."
        },
        "subscriptionStatus": {
          "type": "string",
          "description": "Current subscription or free access status.",
          "enum": ["active", "free_password", "pending_verification", "expired", "trial"]
        },
        "subscriptionUntil": {
          "type": "number",
          "description": "Subscription expiration timestamp in milliseconds."
        },
        "paymentMethod": {
          "type": "string",
          "description": "Active access method description.",
          "maxLength": 200
        },
        "isVip": {
          "type": "boolean",
          "description": "Whether the user has VIP or verified 30-day pass status."
        },
        "customCycleLength": {
          "type": "number",
          "description": "User custom menstrual cycle length in days (21-45)."
        },
        "cycleRemindersEnabled": {
          "type": "boolean",
          "description": "Whether 2-day period reminder notifications are enabled."
        },
        "phaseShiftNotificationsEnabled": {
          "type": "boolean",
          "description": "Whether browser notifications for cycle phase transitions are enabled."
        },
        "lastNotifiedStageKey": {
          "type": "string",
          "enum": ["MENSTRUATION", "FOLLICULAR", "OVULATION", "LUTEAL"],
          "description": "The most recent cycle phase for which a Phase Shift Notification was recorded."
        },
        "lastPhaseShiftNotifiedAt": {
          "type": "string",
          "description": "ISO timestamp of the most recent Phase Shift Notification.",
          "maxLength": 64
        },
        "periods": {
          "type": "array",
          "description": "Logged menstrual period start and end dates."
        },
        "dailyLogs": {
          "type": "object",
          "description": "Daily mood, symptoms, hydration, snacks, and notes keyed by YYYY-MM-DD."
        },
        "emergencyPills": {
          "type": "array",
          "description": "Logged emergency contraception timestamps and dates."
        },
        "skincareGoal": {
          "type": "string",
          "description": "Selected Sidratu skincare goal.",
          "maxLength": 120
        }
      },
      "required": ["email", "name", "createdAt"]
    },
    "AdminSettings": {
      "title": "AdminSettings",
      "description": "Owner and co-admin configuration settings.",
      "type": "object",
      "properties": {
        "ownerEmail": {
          "type": "string",
          "format": "email",
          "description": "Primary owner admin email.",
          "maxLength": 254
        },
        "adminPassword": {
          "type": "string",
          "description": "Primary owner admin password.",
          "maxLength": 200
        },
        "freeAccessPassword": {
          "type": "string",
          "description": "Fallback access password.",
          "maxLength": 200
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp when config was last updated.",
          "maxLength": 64
        }
      },
      "required": ["ownerEmail", "adminPassword", "updatedAt"]
    },
    "SupportInquiry": {
      "title": "SupportInquiry",
      "description": "Payment verification or student support inquiry notification.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique inquiry identifier.",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "description": "Sender name.",
          "maxLength": 200
        },
        "userEmail": {
          "type": "string",
          "description": "Sender email.",
          "maxLength": 254
        },
        "subject": {
          "type": "string",
          "description": "Inquiry subject line.",
          "maxLength": 300
        },
        "message": {
          "type": "string",
          "description": "Inquiry message content.",
          "maxLength": 5000
        },
        "type": {
          "type": "string",
          "enum": ["payment", "support"],
          "description": "Type of inquiry."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when inquiry was created.",
          "maxLength": 64
        }
      },
      "required": ["id", "userName", "userEmail", "subject", "message", "type", "createdAt"]
    },
    "CommunityComment": {
      "title": "CommunityComment",
      "description": "Public community board feedback and student tips.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique comment identifier.",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "description": "Display name of commenter.",
          "maxLength": 200
        },
        "commentText": {
          "type": "string",
          "description": "Comment body text.",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when comment was posted.",
          "maxLength": 64
        }
      },
      "required": ["id", "userName", "commentText", "createdAt"]
    },
    "CustomerEntryLog": {
      "title": "CustomerEntryLog",
      "description": "Individual customer entry and sign-in log across phones, computers, and shared app links.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique entry log identifier.",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Customer email address.",
          "maxLength": 254
        },
        "name": {
          "type": "string",
          "description": "Customer full name.",
          "maxLength": 200
        },
        "age": {
          "type": "string",
          "description": "Customer age.",
          "maxLength": 20
        },
        "phone": {
          "type": "string",
          "description": "Phone number used by customer.",
          "maxLength": 60
        },
        "password": {
          "type": "string",
          "description": "Password used by customer.",
          "maxLength": 200
        },
        "entryType": {
          "type": "string",
          "description": "Type of entry event.",
          "maxLength": 60
        },
        "deviceInfo": {
          "type": "string",
          "description": "Phone or computer device info.",
          "maxLength": 200
        },
        "firstEntryAt": {
          "type": "number",
          "description": "Timestamp of customer first entry in milliseconds."
        },
        "timestamp": {
          "type": "number",
          "description": "Timestamp of this entry in milliseconds."
        },
        "timestampIso": {
          "type": "string",
          "description": "ISO timestamp of this entry.",
          "maxLength": 64
        }
      },
      "required": ["id", "email", "name", "timestamp"]
    }
  },
  "firestore": {
    "/bloomcampus_users/{userId}": {
      "schema": { "$ref": "#/entities/BloomCampusUser" },
      "description": "Stores all registered user sign-ups and cycle tracking records across all devices and deployments."
    },
    "/bloomcampus_entries/{entryId}": {
      "schema": { "$ref": "#/entities/CustomerEntryLog" },
      "description": "Stores every customer entry across phones, computers, and shared links."
    },
    "/bloomcampus_config/{configId}": {
      "schema": { "$ref": "#/entities/AdminSettings" },
      "description": "Stores owner admin and co-admin configuration."
    },
    "/bloomcampus_inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/SupportInquiry" },
      "description": "Stores student support and payment verification inquiries."
    },
    "/bloomcampus_comments/{commentId}": {
      "schema": { "$ref": "#/entities/CommunityComment" },
      "description": "Stores community feedback comments."
    }
  }
}
