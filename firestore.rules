rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidDocId(id) {
      return id is string && id.size() >= 1 && id.size() <= 254 && id.matches('^[a-zA-Z0-9_\\-@.+]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidBloomCampusUser(data) {
      return data is map
        && data.keys().hasAll(['email', 'name'])
        && data.keys().size() <= 80
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 200;
    }

    function isValidCustomerEntry(data) {
      return data is map
        && data.keys().hasAll(['id', 'email', 'name'])
        && data.keys().size() <= 30
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 128
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 200;
    }

    function isValidAdminSettings(data) {
      return data is map
        && data.keys().hasAll(['ownerEmail', 'adminPassword'])
        && data.keys().size() <= 20
        && data.ownerEmail is string
        && data.ownerEmail.size() >= 3
        && data.ownerEmail.size() <= 254
        && data.adminPassword is string
        && data.adminPassword.size() >= 1
        && data.adminPassword.size() <= 200;
    }

    function isValidSupportInquiry(data) {
      return data is map
        && data.keys().hasAll(['id', 'userName', 'userEmail', 'subject', 'message', 'type', 'createdAt'])
        && data.keys().size() <= 20
        && data.id is string
        && data.id.size() <= 128
        && data.userName is string
        && data.userName.size() <= 200
        && data.userEmail is string
        && data.userEmail.size() <= 254
        && data.subject is string
        && data.subject.size() <= 300
        && data.message is string
        && data.message.size() <= 5000
        && (data.type == 'payment' || data.type == 'support')
        && data.createdAt is string
        && data.createdAt.size() <= 64;
    }

    function isValidCommunityComment(data) {
      return data is map
        && data.keys().hasAll(['id', 'userName', 'commentText', 'createdAt'])
        && data.keys().size() <= 15
        && data.id is string
        && data.id.size() <= 128
        && data.userName is string
        && data.userName.size() <= 200
        && data.commentText is string
        && data.commentText.size() >= 1
        && data.commentText.size() <= 1000
        && data.createdAt is string
        && data.createdAt.size() <= 64;
    }

    // Connection health check path
    match /test/{docId} {
      allow get, list: if true;
      allow write: if false;
    }

    // Registered users & sign-ups directory across all devices and URLs
    match /bloomcampus_users/{userId} {
      allow get, list: if true;
      allow create, update: if isValidDocId(userId) && isValidBloomCampusUser(incoming());
      allow delete: if isValidDocId(userId);
    }

    // Individual customer entries across all phones, computers, and shared links
    match /bloomcampus_entries/{entryId} {
      allow get, list: if true;
      allow create, update: if isValidDocId(entryId) && isValidCustomerEntry(incoming());
      allow delete: if isValidDocId(entryId);
    }

    // Owner Admin & Co-Admin settings
    match /bloomcampus_config/{configId} {
      allow get, list: if true;
      allow create, update: if isValidDocId(configId) && isValidAdminSettings(incoming());
      allow delete: if false;
    }

    // Payment & support inquiries
    match /bloomcampus_inquiries/{inquiryId} {
      allow get, list: if true;
      allow create, update: if isValidDocId(inquiryId) && isValidSupportInquiry(incoming());
      allow delete: if isValidDocId(inquiryId);
    }

    // Community board comments
    match /bloomcampus_comments/{commentId} {
      allow get, list: if true;
      allow create, update: if isValidDocId(commentId) && isValidCommunityComment(incoming());
      allow delete: if isValidDocId(commentId);
    }
  }
}
